# ============================================
# APPLICATION
# ============================================
NODE_ENV=development
PORT=3000
SERVICE_NAME=notification-service

# ============================================
# DATABASE
# ============================================
MONGODB_URI=mongodb://mongo-root:replace-with-url-safe-password@localhost:27017/notification_service?authSource=admin
MONGODB_DB_NAME=notification_service
MONGO_INITDB_ROOT_USERNAME=mongo-root
MONGO_INITDB_ROOT_PASSWORD=replace-with-a-random-hex-password

# ============================================
# REDIS
# ============================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=replace-with-a-random-redis-password
REDIS_DB=0

# ============================================
# JWT
# ============================================
# Use a unique random value of at least 32 characters in every environment.
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
JWT_EXPIRES_IN=7d

# Required in production for trusted internal event-ingestion callers.
SERVICE_API_KEY=replace-with-a-random-service-key-of-at-least-32-characters

# Dedicated browser login for the Bull Board queue dashboard.
QUEUE_DASHBOARD_USERNAME=ops-admin
QUEUE_DASHBOARD_PASSWORD=replace-with-a-unique-password-at-least-16-characters

# Comma-separated browser origins allowed to call the API.
# In production, set this to your actual frontend origin(s).
CORS_ORIGINS=http://localhost:3000

# Required only when running the initial administrator seed.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=replace-with-a-unique-password-at-least-12-characters
SEED_ADMIN_NAME=Platform Administrator

# Development-only Mongo Express UI credentials.
MONGO_EXPRESS_USERNAME=admin
MONGO_EXPRESS_PASSWORD=replace-with-a-unique-dev-password

# ============================================
# AMAZON SES (EMAIL)
# ============================================
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
SES_FROM_EMAIL=noreply@yourdomain.com
SES_FROM_NAME=Qavach Health

# ============================================
# FIREBASE (PUSH)
# ============================================
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_PRIVATE_KEY_ID=your-private-key-id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your-project.iam.gserviceaccount.com
FIREBASE_CLIENT_ID=your-client-id

# ============================================
# MSG91 (SMS)
# ============================================
MSG91_AUTH_KEY=your-msg91-auth-key
MSG91_SENDER_ID=QAVACH
MSG91_DLT_TE_ID=your-dlt-template-entity-id
MSG91_ROUTE=4

# ============================================
# MICROSOFT GRAPH (STAFF CALENDAR)
# ============================================
MS_GRAPH_TENANT_ID=your-tenant-id
MS_GRAPH_CLIENT_ID=your-client-id
MS_GRAPH_CLIENT_SECRET=your-client-secret

# ============================================
# RATE LIMITING
# ============================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
BULK_NOTIFICATION_BATCH_SIZE=100
BULK_NOTIFICATION_DELAY_MS=1000

# ============================================
# QUEUE
# ============================================
QUEUE_CONCURRENCY=5
QUEUE_MAX_RETRIES=3
QUEUE_BACKOFF_DELAY=5000

# ============================================
# LOGGING
# ============================================
LOG_LEVEL=info
LOG_DIR=./logs
